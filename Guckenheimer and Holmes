import numpy as np
import os
import matplotlib.pyplot as plt

# --- Parametros fisicos -------------------------------------------------
DELTA, ALPHA, BETA, GAMMA, OMEGA = 0.15, -1.0, 1.0, 0.3, 1.0
SIGNO_LINEAL = +1     # +1: doble pozo (Fig. 1b);  -1: ecuacion (1) literal

# --- Parametros numericos -----------------------------------------------
X0, V0 = 0.1, 0.0
N_TRANS = 300     # periodos descartados
N_PTS = 30000     # puntos del mapa
SPP = 200         # pasos RK4 por periodo

T = 2 * np.pi / OMEGA
h = T / SPP


def f(t, x, v):
    dx = v
    dv = -DELTA * v - SIGNO_LINEAL * ALPHA * x - BETA * x**3 + GAMMA * np.cos(OMEGA * t)
    return dx, dv


def main():
    print("Calculando... (puede tardar uno o dos minutos)")
    x, v, t = X0, V0, 0.0
    puntos = []
    for n in range(N_TRANS + N_PTS):
        for _ in range(SPP):
            k1x, k1v = f(t, x, v)
            k2x, k2v = f(t + h / 2, x + h / 2 * k1x, v + h / 2 * k1v)
            k3x, k3v = f(t + h / 2, x + h / 2 * k2x, v + h / 2 * k2v)
            k4x, k4v = f(t + h, x + h * k3x, v + h * k3v)
            x += h / 6 * (k1x + 2 * k2x + 2 * k3x + k4x)
            v += h / 6 * (k1v + 2 * k2v + 2 * k3v + k4v)
            t += h
        if n >= N_TRANS:              # mapa estroboscopico: t = 2*pi*n/omega
            puntos.append((x, v))
    p = np.array(puntos)
    print(f"x en [{p[:,0].min():.2f}, {p[:,0].max():.2f}],  xdot en [{p[:,1].min():.2f}, {p[:,1].max():.2f}]")

    fig, ax = plt.subplots(figsize=(5.4, 5))
    ax.plot(p[:, 0], p[:, 1], ".", ms=1.0, color="navy")
    ax.set_xlabel("x")
    ax.set_ylabel(r"$\dot{x}$")
    ax.set_title(r"Ej. 3: $\delta=0.15$ (doble pozo, $-x+x^3$)", fontsize=10)
    fig.tight_layout()
    fig.savefig("fig_ej3.png", dpi=170)
    print("Figura guardada en:", os.path.abspath("fig_ej3.png"))
    plt.show()   # abre la ventana con la grafica


if __name__ == "__main__":
    main()
